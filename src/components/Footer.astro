---
const year = new Date().getFullYear();
const social = [
  { href: 'https://github.com/nkb-bd', label: 'github' },
  { href: 'https://www.linkedin.com/in/lukman-nakib', label: 'linkedin' },
  { href: 'https://x.com/mr_mihi', label: 'x' },
  { href: 'https://profiles.wordpress.org/pyrobd', label: 'wp.org' },
];
---
<footer class="footer">
  <div class="container footer-inner">
    <nav class="footer-links" aria-label="Social">
      {social.map((s) => <a href={s.href} rel="me noopener" target="_blank">{s.label}</a>)}
    </nav>
    <p class="footer-meta">© {year} Lukman Nakib</p>
  </div>
</footer>

<style>
  .footer { margin-top: auto; border-top: 1px solid var(--line); padding-block: var(--sp-8); }
  .footer-inner { display: flex; flex-wrap: wrap; align-items: center; gap: var(--sp-4) var(--sp-6); }
  .footer-links { display: flex; flex-wrap: wrap; gap: var(--sp-4); margin-right: auto; font-family: var(--mono); font-size: 13px; }
  .footer-links a { color: var(--muted); border-bottom: 0; }
  .footer-links a:hover { color: var(--accent-ink); }
  .footer-meta { color: var(--muted); font-family: var(--mono); font-size: 12px; }
</style>
