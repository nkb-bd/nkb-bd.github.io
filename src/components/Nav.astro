---
const links = [
  { href: '/work', label: 'work' },
  { href: '/experience', label: 'experience' },
  { href: '/projects', label: 'projects' },
  { href: '/writing', label: 'writing' },
  { href: '/notes', label: 'notes' },
  { href: '/about', label: 'about' },
];
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---
<header class="nav">
  <div class="container nav-inner">
    <a href="/" class="brand" aria-label="Lukman Nakib — home">
      <span class="bk">&lt;</span> Lukman Nakib <span class="bk">/&gt;</span>
    </a>
    <nav class="nav-links" aria-label="Primary">
      {links.map((l) => (
        <a href={l.href} class:list={['nav-link', { active: isActive(l.href) }]}>{l.label}</a>
      ))}
      <a class="nav-link resume" href="https://www.linkedin.com/in/lukmannakib" target="_blank" rel="noopener">Resume</a>
    </nav>
    <div class="theme-menu">
      <button id="theme-btn" class="theme-btn" type="button" aria-haspopup="menu" aria-expanded="false" aria-label="Choose theme">
        <span class="sw sw-current" aria-hidden="true"></span>
      </button>
      <div id="theme-pop" class="theme-pop" role="menu" aria-label="Theme" hidden>
        <button class="theme-opt" type="button" role="menuitemradio" data-theme-val="light"><span class="sw sw-light" aria-hidden="true"></span>Light</button>
        <button class="theme-opt" type="button" role="menuitemradio" data-theme-val="dark"><span class="sw sw-dark" aria-hidden="true"></span>Dark</button>
        <button class="theme-opt" type="button" role="menuitemradio" data-theme-val="space"><span class="sw sw-space" aria-hidden="true"></span>Space</button>
      </div>
    </div>
  </div>
</header>

<style>
  .nav {
    position: sticky; top: 0; z-index: var(--z-nav);
    border-bottom: 1px solid color-mix(in oklch, var(--line) 80%, transparent);
    background: color-mix(in oklch, var(--bg) 78%, transparent);
    backdrop-filter: saturate(1.5) blur(12px);
    -webkit-backdrop-filter: saturate(1.5) blur(12px);
  }
  .nav-inner { display: flex; align-items: center; gap: var(--sp-4); height: 60px; }
  .brand { font-family: var(--display); font-size: 1.05rem; font-weight: 700; color: var(--ink); border-bottom: 0; white-space: nowrap; letter-spacing: -0.015em; }
  .brand .bk { color: var(--accent); font-weight: 600; }
  .brand:hover { color: var(--accent-ink); }
  .nav-links { display: flex; align-items: center; gap: 20px; margin-left: auto; font-family: var(--display); }
  .nav-link { position: relative; font-size: 14px; font-weight: 500; color: var(--muted); border-bottom: 0; letter-spacing: -0.005em; padding-block: 6px; text-transform: capitalize; }
  .resume {
    color: var(--accent-ink) !important; padding: 6px 15px; margin-left: 2px;
    border: 1px solid color-mix(in oklch, var(--accent) 50%, transparent); border-radius: 999px;
    font-size: 13px; transition: background 140ms var(--ease), border-color 140ms var(--ease);
  }
  .resume:hover { background: color-mix(in oklch, var(--accent) 12%, transparent); border-color: var(--accent); }
  .resume::after { display: none; }
  .nav-link::after { content: ''; position: absolute; left: 0; right: 0; bottom: 0; height: 2px; border-radius: 2px; background: var(--accent); transform: scaleX(0); transform-origin: left; transition: transform 180ms var(--ease); }
  .nav-link:hover { color: var(--ink); }
  .nav-link:hover::after, .nav-link.active::after { transform: scaleX(1); }
  .nav-link.active { color: var(--accent-ink); }
  .theme-menu { position: relative; }
  .theme-btn { display: grid; place-items: center; width: 32px; height: 32px; border: 1px solid var(--line); border-radius: 8px; background: transparent; cursor: pointer; transition: border-color 140ms; }
  .theme-btn:hover { border-color: var(--accent); }
  .sw { width: 14px; height: 14px; border-radius: 50%; border: 1px solid color-mix(in oklch, var(--ink) 24%, transparent); display: inline-block; flex: none; }
  .sw-light { background: oklch(0.97 0.006 85); }
  .sw-dark { background: oklch(0.24 0.02 262); }
  .sw-space { background: radial-gradient(circle at 32% 30%, oklch(0.82 0.14 250), oklch(0.26 0.08 264) 78%); border-color: transparent; }
  .theme-pop {
    position: absolute; right: 0; top: calc(100% + 8px); display: flex; flex-direction: column; gap: 2px;
    padding: 6px; min-width: 150px; background: var(--surface); border: 1px solid var(--line); border-radius: 12px;
    box-shadow: 0 14px 34px -14px color-mix(in oklch, black 55%, transparent); z-index: var(--z-nav);
  }
  .theme-pop[hidden] { display: none; }
  .theme-opt {
    display: flex; align-items: center; gap: 10px; width: 100%; padding: 8px 10px; border: 0; border-radius: 8px;
    background: transparent; color: var(--ink); font-family: var(--mono); font-size: 13px; cursor: pointer; text-align: left;
    transition: background 120ms, color 120ms;
  }
  .theme-opt:hover { background: color-mix(in oklch, var(--accent) 12%, transparent); }
  .theme-opt[aria-checked='true'] { color: var(--accent-ink); background: color-mix(in oklch, var(--accent) 15%, transparent); }
  .theme-opt[aria-checked='true'] .sw { box-shadow: 0 0 0 2px color-mix(in oklch, var(--accent) 45%, transparent); }
  @media (max-width: 34rem) { .nav-links { gap: var(--sp-3); } }
</style>

<script is:inline>
  (() => {
    const root = document.documentElement;
    const btn = document.getElementById('theme-btn');
    const pop = document.getElementById('theme-pop');
    if (!btn || !pop) return;
    const swatch = btn.querySelector('.sw');
    const opts = [...pop.querySelectorAll('.theme-opt')];
    const cur = () => root.getAttribute('data-theme') || 'light';
    const sync = () => {
      const c = cur();
      swatch.className = 'sw sw-' + c;
      opts.forEach((o) => o.setAttribute('aria-checked', String(o.dataset.themeVal === c)));
    };
    const open = (v) => { pop.hidden = !v; btn.setAttribute('aria-expanded', String(v)); };
    btn.addEventListener('click', (e) => { e.stopPropagation(); open(pop.hidden); });
    opts.forEach((o) => o.addEventListener('click', () => {
      root.setAttribute('data-theme', o.dataset.themeVal);
      try { localStorage.setItem('theme', o.dataset.themeVal); } catch (e) {}
      sync(); open(false);
    }));
    document.addEventListener('click', (e) => { if (!pop.hidden && !e.target.closest('.theme-menu')) open(false); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape') open(false); });
    sync();
  })();
</script>
