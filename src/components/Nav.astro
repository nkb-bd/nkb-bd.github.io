---
const links = [
  { href: '/work', label: 'work' },
  { href: '/projects', label: 'projects' },
  { href: '/writing', label: 'writing' },
  { href: '/notes', label: 'notes' },
  { href: '/about', label: 'about' },
];
const path = Astro.url.pathname;
const isActive = (href: string) => path === href || path.startsWith(href + '/');
---
<header class="nav">
  <div class="container nav-inner">
    <a href="/" class="brand" aria-label="Lukman Nakib — home">
      <span class="bk">&lt;</span> Lukman Nakib <span class="bk">/&gt;</span>
    </a>
    <nav class="nav-links" aria-label="Primary">
      {links.map((l) => (
        <a href={l.href} class:list={['nav-link', { active: isActive(l.href) }]}>{l.label}</a>
      ))}
      <a class="nav-link resume" href="https://www.linkedin.com/in/lukmannakib" target="_blank" rel="noopener">résumé</a>
    </nav>
    <button id="theme-toggle" class="theme-toggle" type="button" aria-label="Toggle theme">
      <span class="theme-icon" aria-hidden="true"></span>
    </button>
  </div>
</header>

<style>
  .nav { border-bottom: 1px solid var(--line); }
  .nav-inner { display: flex; align-items: center; gap: var(--sp-4); height: 58px; }
  .brand { font-family: var(--display); font-size: 1.05rem; font-weight: 700; color: var(--ink); border-bottom: 0; white-space: nowrap; letter-spacing: -0.01em; }
  .brand .bk { color: var(--accent); }
  .brand:hover { color: var(--accent-ink); }
  .resume { color: var(--accent-ink) !important; }
  .nav-links { display: flex; gap: var(--sp-4); margin-left: auto; font-family: var(--mono); }
  .nav-link { font-size: 13px; color: var(--muted); border-bottom: 0; }
  .nav-link:hover { color: var(--ink); }
  .nav-link.active { color: var(--accent-ink); }
  .theme-toggle {
    display: grid; place-items: center; width: 32px; height: 32px;
    border: 1px solid var(--line); border-radius: 6px; background: transparent; cursor: pointer;
  }
  .theme-toggle:hover { border-color: var(--accent); }
  .theme-icon { width: 13px; height: 13px; border-radius: 50%; background: var(--ink); box-shadow: inset -4px -4px 0 0 var(--bg); }
  :root[data-theme='dark'] .theme-icon { box-shadow: none; background: var(--accent); }
  @media (max-width: 34rem) { .nav-links { gap: var(--sp-3); } }
</style>

<script is:inline>
  document.getElementById('theme-toggle')?.addEventListener('click', () => {
    const root = document.documentElement;
    const next = root.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
    root.setAttribute('data-theme', next);
    try { localStorage.setItem('theme', next); } catch (e) {}
  });
</script>
