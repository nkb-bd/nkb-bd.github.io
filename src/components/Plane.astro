---
---
<button id="plane" class="plane" type="button" aria-label="Toy airplane — click, then fly it with the arrow keys">
  <span class="plane-holder">
    <svg class="plane-gfx" viewBox="0 0 76 60" width="50" height="40" aria-hidden="true">
      <path d="M71 21 L5 5 L33 31 Z" fill="var(--plane-light)" />
      <path d="M71 21 L33 31 L23 55 Z" fill="var(--accent)" />
      <path d="M71 21 L33 31 L29 40 Z" fill="var(--accent-ink)" />
    </svg>
  </span>
</button>
<span id="plane-hint" class="plane-hint">click · <kbd>↑↓←→</kbd> fly · <kbd>space</kbd> roll · fly through rings</span>

<style>
  .plane {
    position: fixed; top: 0; left: 0; z-index: 60;
    padding: 0; border: 0; background: transparent; cursor: grab; line-height: 0;
    will-change: transform;
    transform: translate3d(var(--x, 78vw), var(--y, 236px), 0);
  }
  .plane:focus { outline: none; }
  .plane:focus-visible .plane-gfx { filter: drop-shadow(0 0 6px color-mix(in oklch, var(--accent) 55%, transparent)); }
  .plane-gfx {
    display: block;
    --plane-light: color-mix(in oklch, var(--accent) 58%, white);
    filter: drop-shadow(0 6px 9px color-mix(in oklch, var(--accent) 30%, transparent));
    transition: scale 160ms var(--ease);
  }
  .plane.flying .plane-gfx { scale: 1.18; }
  .plane.boosting .plane-gfx { scale: 1.32; filter: drop-shadow(0 0 12px var(--accent)); }
  .plane-holder {
    display: block;
    transform: rotate(var(--tilt, 0deg)) scaleX(var(--flip, 1));
    transform-origin: 50% 50%;
    transition: transform 90ms linear;
  }
  .plane.flying { cursor: grabbing; }
  .plane-gfx.roll { animation: barrel 0.62s cubic-bezier(0.5, 0, 0.5, 1); }
  @keyframes barrel { to { transform: rotate(360deg); } }
  .plane:not(.flying) .plane-holder { animation: bob 3.4s var(--ease) infinite; }
  @keyframes bob { 0%, 100% { translate: 0 0; } 50% { translate: 0 -6px; } }

  .plane-hint {
    position: fixed; z-index: 60; top: 0; left: 0;
    transform: translate3d(calc(var(--x, 78vw) - 6px), calc(var(--y, 236px) + 40px), 0);
    font-family: var(--mono); font-size: 10px; color: var(--muted); white-space: nowrap;
    opacity: 0; pointer-events: none; transition: opacity 200ms;
  }
  .plane-hint kbd { font-family: var(--mono); color: var(--accent-ink); }
  .plane:hover + .plane-hint, .plane:focus-visible + .plane-hint, .plane.flying + .plane-hint { opacity: 0.85; }

  @media (max-width: 64rem) { .plane, .plane-hint { display: none; } }
  @media (prefers-reduced-motion: reduce) {
    .plane:not(.flying) .plane-holder { animation: none; }
    .plane-gfx.roll { animation: none; }
  }
</style>

<style is:global>
  /* game layer — created in JS + appended to body, so must be global */
  .plane-layer { position: fixed; inset: 0; z-index: 55; pointer-events: none; }
  .plane-layer canvas { position: absolute; inset: 0; width: 100%; height: 100%; }
  .plane-rings { position: absolute; inset: 0; }
  .plane-layer .ring {
    position: absolute; top: 0; left: 0;
    border: 3px solid var(--accent);
    border-radius: 50%;
    opacity: 0.5;
    box-shadow: 0 0 0 4px color-mix(in oklch, var(--accent) 14%, transparent);
    will-change: transform, opacity;
  }
  .plane-layer .ring.pop { animation: plane-ringpop 0.34s ease-out forwards; }
  @keyframes plane-ringpop { to { transform: scale(1.9); opacity: 0; } }
  .plane-score {
    position: absolute; top: 92px; right: 40px;
    font-family: var(--mono); font-size: 13px; color: var(--accent-ink);
    opacity: 0; transition: opacity 250ms; transform-origin: right center;
  }
  .plane-score.show { opacity: 0.95; }
  .plane-score.bump { animation: plane-scorebump 0.26s ease; }
  @keyframes plane-scorebump { 0% { transform: scale(1); } 40% { transform: scale(1.35); } 100% { transform: scale(1); } }
  @media (max-width: 64rem) { .plane-layer { display: none; } }
  @media (prefers-reduced-motion: reduce) { .plane-layer .ring.pop { animation: none; } }
</style>

<script is:inline>
  (() => {
    const plane = document.getElementById('plane');
    const holder = plane && plane.querySelector('.plane-holder');
    const gfx = plane && plane.querySelector('.plane-gfx');
    const hint = document.getElementById('plane-hint');
    if (!plane || !holder || !gfx) return;
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;

    let x = Math.round(innerWidth * 0.78), y = 236;
    let vx = 0, vy = 0, rot = 0;
    let active = false, timer = null, boostUntil = 0, score = 0;
    let prevCx = null, prevCy = null;
    const held = new Set();
    const lastTap = { up: 0, down: 0, left: 0, right: 0 };

    const ACC = 0.55, FRICTION = 0.965, MAX = 15, IMPULSE = 3.6, DASH = 13;
    const key = {
      ArrowUp: 'up', ArrowDown: 'down', ArrowLeft: 'left', ArrowRight: 'right',
      w: 'up', s: 'down', a: 'left', d: 'right', W: 'up', S: 'down', A: 'left', D: 'right',
    };
    const vec = { up: [0, -1], down: [0, 1], left: [-1, 0], right: [1, 0] };

    // game layer
    const layer = document.createElement('div');
    layer.className = 'plane-layer'; layer.setAttribute('aria-hidden', 'true');
    document.body.appendChild(layer);
    const canvas = document.createElement('canvas'); layer.appendChild(canvas);
    const ctx = canvas.getContext('2d');
    const scoreEl = document.createElement('div'); scoreEl.className = 'plane-score'; layer.appendChild(scoreEl);
    const ringsBox = document.createElement('div'); ringsBox.className = 'plane-rings'; layer.appendChild(ringsBox);
    let accent = getComputedStyle(document.documentElement).getPropertyValue('--accent').trim() || '#3b6bff';
    const sizeCanvas = () => { canvas.width = innerWidth; canvas.height = innerHeight; };
    sizeCanvas(); addEventListener('resize', sizeCanvas);

    let rings = [];
    const spawnRing = () => {
      const el = document.createElement('span'); el.className = 'ring';
      const r = 24 + Math.random() * 12;
      const rx = innerWidth * (0.5 + Math.random() * 0.42);
      const ry = 150 + Math.random() * Math.max(160, Math.min(innerHeight, 760) - 240);
      el.style.width = el.style.height = (r * 2) + 'px';
      el.style.left = (rx - r) + 'px'; el.style.top = (ry - r) + 'px';
      ringsBox.appendChild(el);
      rings.push({ el, x: rx, y: ry, r });
    };
    const setScore = () => { scoreEl.textContent = 'score ' + score; };
    const startGame = () => {
      if (rings.length) return;
      score = 0; setScore(); scoreEl.classList.add('show');
      for (let i = 0; i < 4; i++) spawnRing();
    };
    const endGame = () => {
      rings.forEach((r) => r.el.remove()); rings = [];
      scoreEl.classList.remove('show');
      ctx.clearRect(0, 0, canvas.width, canvas.height);
    };

    // continuously fade the skywriting
    if (!reduce) setInterval(() => {
      ctx.globalCompositeOperation = 'destination-out';
      ctx.fillStyle = 'rgba(0,0,0,0.05)';
      ctx.fillRect(0, 0, canvas.width, canvas.height);
    }, 60);

    const place = () => {
      plane.style.setProperty('--x', x + 'px'); plane.style.setProperty('--y', y + 'px');
      hint.style.setProperty('--x', x + 'px'); hint.style.setProperty('--y', y + 'px');
    };
    place();

    const step = () => {
      const boosting = performance.now() < boostUntil;
      let ax = 0, ay = 0;
      if (held.has('left')) ax -= ACC; if (held.has('right')) ax += ACC;
      if (held.has('up')) ay -= ACC; if (held.has('down')) ay += ACC;
      vx = (vx + ax) * FRICTION; vy = (vy + ay) * FRICTION;
      const cap = boosting ? MAX * 1.7 : MAX;
      const sp = Math.hypot(vx, vy);
      if (sp > cap) { vx = vx / sp * cap; vy = vy / sp * cap; }
      x += vx; y += vy;
      const maxX = innerWidth - 56, maxY = innerHeight - 56;
      if (x < 4) { x = 4; vx = Math.abs(vx) * 0.55; }
      if (x > maxX) { x = maxX; vx = -Math.abs(vx) * 0.55; }
      if (y < 4) { y = 4; vy = Math.abs(vy) * 0.55; }
      if (y > maxY) { y = maxY; vy = -Math.abs(vy) * 0.55; }
      if (sp > 0.5) {
        let d = ((Math.atan2(vy, vx) - rot + Math.PI) % (Math.PI * 2)) - Math.PI;
        if (d < -Math.PI) d += Math.PI * 2;
        rot += d * 0.18; // smooth banking turn toward heading
      }
      place();
      holder.style.setProperty('--rot', rot.toFixed(3) + 'rad');
      plane.classList.toggle('boosting', boosting);

      const cx = x + 25, cy = y + 20;
      if (!reduce && prevCx != null && sp > 0.4) {
        ctx.globalCompositeOperation = 'source-over';
        ctx.strokeStyle = accent; ctx.lineCap = 'round';
        ctx.lineWidth = boosting ? 7 : 3.5;
        ctx.beginPath(); ctx.moveTo(prevCx, prevCy); ctx.lineTo(cx, cy); ctx.stroke();
      }
      prevCx = cx; prevCy = cy;

      for (let i = rings.length - 1; i >= 0; i--) {
        const ring = rings[i];
        if (Math.hypot(cx - ring.x, cy - ring.y) < ring.r) {
          ring.el.classList.add('pop');
          const el = ring.el; setTimeout(() => el.remove(), 340);
          rings.splice(i, 1);
          score += 10; setScore();
          scoreEl.classList.remove('bump'); void scoreEl.offsetWidth; scoreEl.classList.add('bump');
          spawnRing();
        }
      }

      if (!(sp > 0.05 || held.size)) {
        clearInterval(timer); timer = null;
        prevCx = prevCy = null; plane.classList.remove('boosting');
      }
    };
    const run = () => { if (timer == null) timer = setInterval(step, 16); };

    const roll = () => { if (!gfx.classList.contains('roll')) gfx.classList.add('roll'); };
    gfx.addEventListener('animationend', (e) => { if (e.animationName === 'barrel') gfx.classList.remove('roll'); });

    const activate = () => {
      if (active) return;
      active = true; plane.classList.add('flying');
      accent = getComputedStyle(document.documentElement).getPropertyValue('--accent').trim() || accent;
      startGame();
    };

    plane.addEventListener('click', () => { activate(); plane.focus(); });

    addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && active) {
        active = false; held.clear(); plane.classList.remove('flying'); plane.blur(); endGame();
        return;
      }
      const d = key[e.key];
      if (!d) return;
      if (!active) { if (document.activeElement !== plane) return; activate(); }
      e.preventDefault();
      if (!held.has(d)) {
        const v = vec[d], now = performance.now();
        vx += v[0] * IMPULSE; vy += v[1] * IMPULSE;
        if (now - lastTap[d] < 260) { vx += v[0] * DASH; vy += v[1] * DASH; boostUntil = now + 420; }
        lastTap[d] = now;
      }
      held.add(d); run();
    });
    addEventListener('keyup', (e) => { const d = key[e.key]; if (d) held.delete(d); });
    addEventListener('keydown', (e) => { if (active && (e.key === ' ' || e.code === 'Space')) { e.preventDefault(); roll(); } });
    addEventListener('blur', () => held.clear());
  })();
</script>
