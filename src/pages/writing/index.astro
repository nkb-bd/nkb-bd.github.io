---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

const items = (await getCollection('writing', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const yr = (d: Date) => d.getFullYear();
---
<BaseLayout
  title="Writing — Lukman Nakib"
  description="Long-form writing on WordPress architecture, plugin engineering, and product decisions at scale."
>
  <section class="container page">
    <header class="page-head">
      <h1>Writing</h1>
      <p class="lede">WordPress architecture, plugin engineering, and the reasoning behind products at scale.</p>
    </header>
    <ul class="index">
      {items.map((p) => (
        <li>
          <a href={`/writing/${p.id}`} class="row-link">
            <span class="leader">
              <span class="leader-title">{p.data.title}</span>
              <span class="leader-fill"></span>
              <span class="leader-year">{yr(p.data.date)}</span>
            </span>
            <p class="row-desc">{p.data.description}</p>
          </a>
        </li>
      ))}
    </ul>
  </section>
</BaseLayout>

<style>
  .page { padding-block: var(--sp-16); }
  .page-head { margin-bottom: var(--sp-12); }
  .lede { margin-top: var(--sp-3); font-size: 1.2rem; line-height: 1.5; color: var(--muted); max-width: 56ch; }
</style>
