---
import BaseLayout from '../layouts/BaseLayout.astro';

const roles = [
  {
    company: 'WPManageNinja',
    title: 'Product Engineer & Technical Lead',
    period: 'Present',
    location: 'Remote · Bangladesh',
    summary:
      'Building and leading engineering on Fluent Forms — a WordPress form builder on 700K+ active sites — and other WPManageNinja products.',
    points: [
      'Architected and maintained large parts of Fluent Forms: the form engine, payments, conversational forms, quizzes, inventory, and save-and-resume systems.',
      'Owned validation across PHP / JavaScript / REST and a long list of third-party SaaS integrations.',
      'Led FluentPlayer — turning a video player into an interactive, measurable system (in-frame forms, CTAs, hotspots, engagement analytics, source-agnostic playback).',
      'Kept a focus on backward compatibility and migration safety at a scale where a small shortcut gets expensive across hundreds of thousands of sites.',
    ],
    tags: ['PHP', 'Vue', 'WordPress', 'REST', 'MySQL'],
  },
  {
    company: 'Metropolitan University',
    title: 'Adjunct Faculty',
    period: '2024 – Present',
    location: 'Sylhet, Bangladesh',
    summary:
      'Teaching Software Engineering and Web Development to undergraduate students, alongside my product engineering work.',
    points: [
      'Teach Software Engineering and Web Development courses to undergraduate students.',
      'Mentor students through their course and capstone projects.',
    ],
    tags: ['Teaching', 'Software Engineering', 'Web Development'],
  },
  // Add earlier roles here, most recent first:
  // {
  //   company: '',
  //   title: '',
  //   period: '20XX – 20XX',
  //   location: '',
  //   summary: '',
  //   points: [''],
  //   tags: [''],
  // },
];
---
<BaseLayout
  title="Experience — Lukman Nakib"
  description="Work experience of Lukman Nakib — WordPress product engineer and technical lead, building Fluent Forms and other WPManageNinja products used on hundreds of thousands of sites."
>
  <div class="container xp">
    <header class="block xp-head">
      <p class="label">Experience</p>
      <h1>Where I've built things</h1>
      <p class="xp-lede">
        A short work history. For case studies and the reasoning behind the work, see
        <a href="/work">selected work</a>; for the résumé, the
        <a href="https://www.linkedin.com/in/lukman-nakib" target="_blank" rel="noopener">LinkedIn</a> version stays current.
      </p>
    </header>

    <ol class="xp-list">
      {roles.map((r) => (
        <li class="xp-item">
          <div class="xp-dot" aria-hidden="true"></div>
          <div class="xp-body">
            <div class="xp-row">
              <h2 class="xp-title">{r.title} <span class="xp-at">· {r.company}</span></h2>
              <span class="xp-period">{r.period}</span>
            </div>
            {r.location && <p class="xp-loc">{r.location}</p>}
            {r.summary && <p class="xp-summary">{r.summary}</p>}
            {r.points?.length > 0 && (
              <ul class="xp-points">
                {r.points.map((p) => <li>{p}</li>)}
              </ul>
            )}
            {r.tags?.length > 0 && (
              <div class="xp-tags">
                {r.tags.map((t) => <span class="xp-tag">{t}</span>)}
              </div>
            )}
          </div>
        </li>
      ))}
    </ol>
  </div>
</BaseLayout>

<style>
  .xp { padding-block: var(--sp-12) var(--sp-16); }
  .xp-head { margin-bottom: var(--sp-12); }
  .xp-head h1 { margin-top: var(--sp-3); }
  .xp-lede { margin-top: var(--sp-4); color: var(--muted); max-width: 56ch; }

  .xp-list { list-style: none; margin: 0; padding: 0; position: relative; }
  .xp-list::before { content: ''; position: absolute; left: 5px; top: 6px; bottom: 6px; width: 1px; background: var(--line); }

  .xp-item { position: relative; padding-left: var(--sp-8); padding-bottom: var(--sp-12); }
  .xp-item:last-child { padding-bottom: 0; }
  .xp-dot { position: absolute; left: 0; top: 6px; width: 11px; height: 11px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 4px var(--bg); }

  .xp-row { display: flex; align-items: baseline; justify-content: space-between; gap: var(--sp-4); flex-wrap: wrap; }
  .xp-title { font-size: 1.35rem; }
  .xp-at { color: var(--accent-ink); font-weight: 700; }
  .xp-period { font-family: var(--mono); font-size: 13px; color: var(--muted); white-space: nowrap; }
  .xp-loc { font-family: var(--mono); font-size: 12px; color: var(--faint); margin-top: 2px; }
  .xp-summary { margin-top: var(--sp-3); color: var(--ink); }
  .xp-points { margin-top: var(--sp-3); padding-left: var(--sp-4); color: var(--muted); font-size: 17px; line-height: 1.55; }
  .xp-points li + li { margin-top: var(--sp-2); }
  .xp-tags { display: flex; flex-wrap: wrap; gap: 6px; margin-top: var(--sp-4); }
  .xp-tag { font-family: var(--mono); font-size: 12px; color: var(--muted); border: 1px solid var(--line); border-radius: 999px; padding: 3px 10px; }
</style>
