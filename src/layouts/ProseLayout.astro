---
import BaseLayout from './BaseLayout.astro';

interface Props {
  title: string;
  description?: string;
  date: Date;
  kind: 'writing' | 'work' | 'notes';
  meta?: string[];
  fig?: string;
  backHref: string;
  backLabel: string;
}

const { title, description, date, kind, meta = [], fig, backHref, backLabel } = Astro.props;
const fmt = date.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const kicker = fig ?? (kind === 'work' ? 'Case study' : kind === 'writing' ? 'Writing' : 'Note');

const article = {
  '@context': 'https://schema.org',
  '@type': kind === 'work' ? 'Article' : 'BlogPosting',
  headline: title,
  description,
  datePublished: date.toISOString(),
  keywords: meta.join(', '),
  author: { '@type': 'Person', name: 'Lukman Nakib', url: Astro.site?.href },
  publisher: { '@type': 'Person', name: 'Lukman Nakib' },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---
<BaseLayout title={`${title} — Lukman Nakib`} description={description} ogType="article">
  <article class="container article">
    <a href={backHref} class="back">← {backLabel}</a>
    <header class="article-head">
      <p class="label">{kicker}</p>
      <h1>{title}</h1>
      <p class="article-meta">
        <time datetime={date.toISOString()}>{fmt}</time>
        {meta.length > 0 && <span> · {meta.join(' · ')}</span>}
      </p>
    </header>
    <div class="prose"><slot /></div>
  </article>
  <script type="application/ld+json" set:html={JSON.stringify(article)} />
</BaseLayout>

<style>
  .article { padding-block: var(--sp-12) var(--sp-16); display: grid; justify-items: start; gap: var(--sp-6); }
  .back { font-family: var(--mono); font-size: 13px; color: var(--muted); border-bottom: 0; }
  .back:hover { color: var(--accent-ink); }
  .article-head { max-width: var(--measure); display: grid; gap: var(--sp-3); padding-bottom: var(--sp-4); border-bottom: 1px solid var(--line); }
  .article-meta { color: var(--muted); font-family: var(--mono); font-size: 13px; }
  .article-sub { width: var(--measure); margin-top: var(--sp-12); }
</style>
